# Скопировать в .env и заполнить (для self-hosted деплоя через docker compose).

# Домен мини-приложения (HTTPS обязателен для Telegram WebApp).
# Должен иметь A-запись на этот VPS. Caddy автоматически выпустит TLS-сертификат.
DOMAIN=mini.example.com

# Токен бота из @BotFather. Используется и ботом, и backend-ом mini-app
# (backend верифицирует Telegram WebApp initData этим токеном).
BOT_TOKEN=your_telegram_bot_token_here

# 0 — продакшен (только Telegram-юзеры).
# 1 — DEV: разрешает X-Dev-User-Id и /api/_demo/seed. На проде не включать.
DEV_MODE=0

# --- Локальный запуск бота вне docker (опционально) ---
# DB_PATH=gym_bot.db
# PADDLE_USE_GPU=0
# TESSERACT_CMD=/usr/bin/tesseract
